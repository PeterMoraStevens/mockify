  "starters": {
    "python": "import sys\nfrom typing import List\n\n\ndef solve(nums: List[int], target: int) -> int:\n    # Return the index of target, or where it would be inserted.\n    return 0\n\n\ndef main() -> None:\n    lines = sys.stdin.read().split(\"\\n\")\n    nums = list(map(int, (lines[0] if len(lines) > 0 else \"\").split()))\n    target = int((lines[1] if len(lines) > 1 else \"\").strip())\n    result = solve(nums, target)\n    print(result)\n\n\nif __name__ == \"__main__\":\n    main()\n",
    "javascript": "function solve(nums, target) {\n  // Return the index of target, or where it would be inserted.\n  return 0;\n}\n\nfunction main() {\n  const lines = require(\"fs\").readFileSync(0, \"utf8\").split(\"\\n\");\n  const line = (i) => (lines[i] ?? \"\").replace(/\\r$/, \"\");\n  const nums = line(0).trim().split(/\\s+/).filter(Boolean).map(Number);\n  const target = Number(line(1).trim());\n  const result = solve(nums, target);\n  console.log(String(result));\n}\n\nmain();\n",
    "typescript": "/// <reference lib=\"es2022\" />\ndeclare const require: any;\n\nfunction solve(nums: number[], target: number): number {\n  // Return the index of target, or where it would be inserted.\n  return 0;\n}\n\nfunction main(): void {\n  const lines: string[] = require(\"fs\").readFileSync(0, \"utf8\").split(\"\\n\");\n  const line = (i: number): string => (lines[i] ?? \"\").replace(/\\r$/, \"\");\n  const nums = line(0).trim().split(/\\s+/).filter(Boolean).map(Number);\n  const target = Number(line(1).trim());\n  const result = solve(nums, target);\n  console.log(String(result));\n}\n\nmain();\n",
    "java": "import java.io.*;\nimport java.util.*;\n\npublic class Main {\n    static int solve(int[] nums, int target) {\n        // Return the index of target, or where it would be inserted.\n        return 0;\n    }\n\n    static String line(List<String> lines, int i) {\n        return i < lines.size() ? lines.get(i) : \"\";\n    }\n\n    static String[] readWords(String s) {\n        String t = s.trim();\n        return t.isEmpty() ? new String[0] : t.split(\"\\\\s+\");\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        List<String> lines = new ArrayList<>();\n        for (String l; (l = br.readLine()) != null; ) lines.add(l);\n        int[] nums = Arrays.stream(readWords(line(lines, 0))).mapToInt(Integer::parseInt).toArray();\n        int target = Integer.parseInt(line(lines, 1).trim());\n        int result = solve(nums, target);\n        System.out.println(result);\n    }\n}\n",
    "c": "#include <stdbool.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\nint solve(int* nums, int numsSize, int target) {\n    // Return the index of target, or where it would be inserted.\n    return 0;\n}\n\nstatic char* read_all(void) {\n    size_t cap = 1 << 16, len = 0;\n    char* buf = malloc(cap);\n    for (;;) {\n        if (len + 1 >= cap) buf = realloc(buf, cap *= 2);\n        size_t r = fread(buf + len, 1, cap - len - 1, stdin);\n        if (r == 0) break;\n        len += r;\n    }\n    buf[len] = '\\0';\n    return buf;\n}\n\nstatic char** g_lines;\nstatic int g_count;\n\nstatic char* line(int i) {\n    return i < g_count ? g_lines[i] : \"\";\n}\n\nstatic int* parse_ints(const char* s, int* n) {\n    int cap = 16;\n    int* out = malloc(cap * sizeof(int));\n    char* end;\n    *n = 0;\n    for (;;) {\n        long v = strtol(s, &end, 10);\n        if (end == s) break;\n        if (*n == cap) out = realloc(out, (cap *= 2) * sizeof(int));\n        out[(*n)++] = (int)v;\n        s = end;\n    }\n    return out;\n}\n\nint main(void) {\n    char* input = read_all();\n    int cap = 8;\n    g_lines = malloc(cap * sizeof(char*));\n    for (char* p = input;;) {\n        if (g_count == cap) g_lines = realloc(g_lines, (cap *= 2) * sizeof(char*));\n        g_lines[g_count++] = p;\n        char* nl = strchr(p, '\\n');\n        size_t n = nl ? (size_t)(nl - p) : strlen(p);\n        if (n && p[n - 1] == '\\r') p[n - 1] = '\\0';\n        if (!nl) break;\n        *nl = '\\0';\n        p = nl + 1;\n    }\n    int numsSize = 0;\n    int* nums = parse_ints(line(0), &numsSize);\n    int target = (int)strtol(line(1), NULL, 10);\n    int result = solve(nums, numsSize, target);\n    printf(\"%d\\n\", result);\n    return 0;\n}\n",
    "cpp": "#include <algorithm>\n#include <climits>\n#include <iostream>\n#include <map>\n#include <queue>\n#include <set>\n#include <sstream>\n#include <stack>\n#include <string>\n#include <unordered_map>\n#include <unordered_set>\n#include <vector>\nusing namespace std;\n\nint solve(vector<int>& nums, int target) {\n    // Return the index of target, or where it would be inserted.\n    return 0;\n}\n\nstatic vector<string> g_lines;\nstatic string line(size_t i) { return i < g_lines.size() ? g_lines[i] : string(); }\nstatic vector<int> readInts(const string& s) {\n    vector<int> v;\n    istringstream is(s);\n    for (int x; is >> x;) v.push_back(x);\n    return v;\n}\nstatic vector<string> readWords(const string& s) {\n    vector<string> v;\n    istringstream is(s);\n    for (string w; is >> w;) v.push_back(w);\n    return v;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    for (string l; getline(cin, l);) {\n        if (!l.empty() && l.back() == '\\r') l.pop_back();\n        g_lines.push_back(l);\n    }\n    vector<int> nums = readInts(line(0));\n    int target = stoi(line(1));\n    int result = solve(nums, target);\n    cout << result << \"\\n\";\n    return 0;\n}\n",
    "csharp": "using System;\nusing System.Collections.Generic;\nusing System.Linq;\n\npublic class Program {\n    static int Solve(int[] nums, int target) {\n        // Return the index of target, or where it would be inserted.\n        return 0;\n    }\n\n    static string[] lines = new string[0];\n    static string Line(int i) => i < lines.Length ? lines[i] : \"\";\n    static string[] Words(string s) => s.Split(new[] { ' ', '\\t' }, StringSplitOptions.RemoveEmptyEntries);\n\n    public static void Main() {\n        lines = Console.In.ReadToEnd().Split('\\n').Select(l => l.TrimEnd('\\r')).ToArray();\n        int[] nums = Words(Line(0)).Select(int.Parse).ToArray();\n        int target = int.Parse(Line(1).Trim());\n        var result = Solve(nums, target);\n        Console.WriteLine(result);\n    }\n}\n",
    "go": "package main\n\nimport (\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n)\n\nfunc solve(nums []int, target int) int {\n\t// Return the index of target, or where it would be inserted.\n\treturn 0\n}\n\nfunc atoi(s string) int {\n\tv, _ := strconv.Atoi(s)\n\treturn v\n}\n\nfunc parseInts(s string) []int {\n\tf := strings.Fields(s)\n\tout := make([]int, len(f))\n\tfor i, w := range f {\n\t\tout[i] = atoi(w)\n\t}\n\treturn out\n}\n\nfunc main() {\n\tdata, _ := io.ReadAll(os.Stdin)\n\tlines := strings.Split(strings.ReplaceAll(string(data), \"\\r\", \"\"), \"\\n\")\n\tline := func(i int) string {\n\t\tif i < len(lines) {\n\t\t\treturn lines[i]\n\t\t}\n\t\treturn \"\"\n\t}\n\tnums := parseInts(line(0))\n\ttarget := atoi(strings.TrimSpace(line(1)))\n\tresult := solve(nums, target)\n\tfmt.Println(result)\n}\n",
    "rust": "#![allow(unused_imports, unused_variables, unused_mut, dead_code)]\nuse std::collections::{HashMap, HashSet, VecDeque};\nuse std::io::{self, Read};\n\nfn solve(nums: Vec<i32>, target: i32) -> i32 {\n    // Return the index of target, or where it would be inserted.\n    0\n}\n\nfn line<'a>(lines: &[&'a str], i: usize) -> &'a str {\n    lines.get(i).copied().unwrap_or(\"\")\n}\n\nfn main() {\n    let mut input = String::new();\n    io::stdin().read_to_string(&mut input).unwrap();\n    let lines: Vec<&str> = input.split('\\n').map(|l| l.trim_end_matches('\\r')).collect();\n    let nums: Vec<i32> = line(&lines, 0).split_whitespace().map(|x| x.parse().unwrap()).collect();\n    let target: i32 = line(&lines, 1).trim().parse().unwrap();\n    let result = solve(nums, target);\n    println!(\"{}\", result);\n}\n",
    "kotlin": "fun solve(nums: IntArray, target: Int): Int {\n    // Return the index of target, or where it would be inserted.\n    return 0\n}\n\nfun readWords(s: String): List<String> = s.trim().split(Regex(\"\\\\s+\")).filter { it.isNotEmpty() }\n\nfun main() {\n    val lines = generateSequence(::readLine).map { it.trimEnd('\\r') }.toList()\n    fun line(i: Int): String = lines.getOrElse(i) { \"\" }\n    val nums = readWords(line(0)).map { it.toInt() }.toIntArray()\n    val target = line(1).trim().toInt()\n    val result = solve(nums, target)\n    println(result)\n}\n",

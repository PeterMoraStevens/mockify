    "code": "import bisect\nimport heapq\nimport math\nfrom collections import Counter\nimport sys\nfrom typing import List\n\n\ndef solve(nums: List[int]) -> int:\n    # Return the minimum of the rotated sorted array.\n    lo, hi = 0, len(nums) - 1\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if nums[mid] > nums[hi]:\n            lo = mid + 1\n        else:\n            hi = mid\n    return nums[lo]\n\n\ndef main() -> None:\n    lines = sys.stdin.read().split(\"\\n\")\n    nums = list(map(int, (lines[0] if len(lines) > 0 else \"\").split()))\n    result = solve(nums)\n    print(result)\n\n\nif __name__ == \"__main__\":\n    main()\n"

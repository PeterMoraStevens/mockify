    "scala": "import scala.collection.mutable\n\nobject Main {\n  def solve(nums: Array[Int]): Int = {\n    // Return the minimum of the rotated sorted array.\n    0\n  }\n\n  def readWords(s: String): Array[String] = s.trim.split(\"\\\\s+\").filter(_.nonEmpty)\n\n  def main(args: Array[String]): Unit = {\n    val lines = scala.io.Source.stdin.getLines().toArray\n    def line(i: Int): String = if (i < lines.length) lines(i).stripSuffix(\"\\r\") else \"\"\n    val nums = readWords(line(0)).map(_.toInt)\n    val result = solve(nums)\n    println(result)\n  }\n}\n",
    "dart": "import 'dart:io';\n\nint solve(List<int> nums) {\n  // Return the minimum of the rotated sorted array.\n  return 0;\n}\n\nList<String> readWords(String s) => s.trim().split(RegExp(r'\\s+')).where((w) => w.isNotEmpty).toList();\n\nvoid main() {\n  final lines = <String>[];\n  while (true) {\n    final l = stdin.readLineSync();\n    if (l == null) break;\n    lines.add(l);\n  }\n  String line(int i) => i < lines.length ? lines[i] : '';\n  final nums = readWords(line(0)).map(int.parse).toList();\n  final result = solve(nums);\n  print(result);\n}\n",

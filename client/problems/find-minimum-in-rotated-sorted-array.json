      "output": "1\n"
    },
    {
      "input": "4 5 6 7 0 1 2\n",
      "output": "0\n"
    },
    {
      "input": "11 13 15 17\n",
      "output": "11\n",
      "explanation": "Not rotated (or rotated a full cycle)."
    }
  ],

    "python": "import sys\nfrom typing import List\n\n\ndef solve(nums: List[int]) -> int:\n    # Return the max sum of non-adjacent elements.\n    return 0\n\n\ndef main() -> None:\n    lines = sys.stdin.read().split(\"\\n\")\n\n    def line(i: int) -> str:\n        return lines[i].rstrip(\"\\r\") if i < len(lines) else \"\"\n\n    nums = [int(x) for x in line(0).split()]\n    result = solve(nums)\n    print(result)\n\n\nif __name__ == \"__main__\":\n    main()\n",
    "javascript": "function solve(nums) {\n  // Return the max sum of non-adjacent elements.\n  return 0;\n}\n\nfunction readWords(s) {\n  return s.trim().split(/\\s+/).filter(Boolean);\n}\n\nfunction main() {\n  const lines = require(\"fs\").readFileSync(0, \"utf8\").split(\"\\n\");\n  const line = (i) => (lines[i] ?? \"\").replace(/\\r$/, \"\");\n  const nums = readWords(line(0)).map((x) => Number(x));\n  const result = solve(nums);\n  console.log(String(result));\n}\n\nmain();\n",
    "typescript": "/// <reference lib=\"es2022\" />\ndeclare const require: any;\n\nfunction solve(nums: number[]): number {\n  // Return the max sum of non-adjacent elements.\n  return 0;\n}\n\nfunction readWords(s: string): string[] {\n  return s.trim().split(/\\s+/).filter(Boolean);\n}\n\nfunction main(): void {\n  const lines: string[] = require(\"fs\").readFileSync(0, \"utf8\").split(\"\\n\");\n  const line = (i: number): string => (lines[i] ?? \"\").replace(/\\r$/, \"\");\n  const nums = readWords(line(0)).map((x) => Number(x));\n  const result = solve(nums);\n  console.log(String(result));\n}\n\nmain();\n",
    "java": "import java.io.*;\nimport java.util.*;\n\npublic class Main {\n    static int solve(int[] nums) {\n        // Return the max sum of non-adjacent elements.\n        return 0;\n    }\n\n    static class Tok {\n        final String[] t;\n        int i = 0;\n        Tok(String s) {\n            String x = s.trim();\n            t = x.isEmpty() ? new String[0] : x.split(\"\\\\s+\");\n        }\n        String next() { return i < t.length ? t[i++] : \"0\"; }\n        int left() { return t.length - i; }\n    }\n\n    static String line(List<String> lines, int i) {\n        return i < lines.size() ? lines.get(i) : \"\";\n    }\n\n    static int[] readAllInt(Tok tk) {\n        int[] res = new int[tk.left()];\n        for (int i = 0; i < res.length; i++) res[i] = Integer.parseInt(tk.next());\n        return res;\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        List<String> lines = new ArrayList<>();\n        for (String _l; (_l = br.readLine()) != null; ) lines.add(_l);\n        int[] nums = readAllInt(new Tok(line(lines, 0)));\n        int result = solve(nums);\n        System.out.println(result);\n    }\n}\n",
    "c": "#include <stdbool.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\nint solve(int* nums, int numsSize) {\n    // Return the max sum of non-adjacent elements.\n    return 0;\n}\n\nstatic char* read_all(void) {\n    size_t cap = 1 << 16, len = 0;\n    char* buf = malloc(cap);\n    for (;;) {\n        if (len + 1 >= cap) buf = realloc(buf, cap *= 2);\n        size_t r = fread(buf + len, 1, cap - len - 1, stdin);\n        if (r == 0) break;\n        len += r;\n    }\n    buf[len] = '\\0';\n    return buf;\n}\n\nstatic char** g_lines;\nstatic int g_count;\n\nstatic char* line(int i) {\n    return i < g_count ? g_lines[i] : \"\";\n}\n\ntypedef struct {\n    char** t;\n    int n, i;\n} Tok;\n\n__attribute__((unused)) static Tok tok(const char* s) {\n    Tok k = {0};\n    char* copy = strdup(s);\n    int cap = 16;\n    k.t = malloc(cap * sizeof(char*));\n    for (char* w = strtok(copy, \" \\t\"); w; w = strtok(NULL, \" \\t\")) {\n        if (k.n == cap) k.t = realloc(k.t, (cap *= 2) * sizeof(char*));\n        k.t[k.n++] = w;\n    }\n    return k;\n}\n\n__attribute__((unused)) static char* tk_next(Tok* k) {\n    return k->i < k->n ? k->t[k->i++] : \"0\";\n}\n\nint main(void) {\n    char* input = read_all();\n    int cap = 8;\n    g_lines = malloc(cap * sizeof(char*));\n    for (char* p = input;;) {\n        if (g_count == cap) g_lines = realloc(g_lines, (cap *= 2) * sizeof(char*));\n        g_lines[g_count++] = p;\n        char* nl = strchr(p, '\\n');\n        size_t n = nl ? (size_t)(nl - p) : strlen(p);\n        if (n && p[n - 1] == '\\r') p[n - 1] = '\\0';\n        if (!nl) break;\n        *nl = '\\0';\n        p = nl + 1;\n    }\n    Tok k0 = tok(line(0));\n    int numsSize = k0.n;\n    int* nums = malloc((numsSize + 1) * sizeof(int));\n    for (int j = 0; j < numsSize; j++) nums[j] = (int)strtol(k0.t[j], NULL, 10);\n    int result = solve(nums, numsSize);\n    printf(\"%d\\n\", result);\n    return 0;\n}\n",
    "cpp": "#include <algorithm>\n#include <climits>\n#include <iostream>\n#include <map>\n#include <numeric>\n#include <queue>\n#include <set>\n#include <sstream>\n#include <stack>\n#include <string>\n#include <unordered_map>\n#include <unordered_set>\n#include <vector>\nusing namespace std;\n\nint solve(vector<int>& nums) {\n    // Return the max sum of non-adjacent elements.\n    return 0;\n}\n\nstruct Tok {\n    vector<string> t;\n    size_t i = 0;\n    explicit Tok(const string& s) {\n        istringstream is(s);\n        for (string w; is >> w;) t.push_back(w);\n    }\n    string next() { return i < t.size() ? t[i++] : \"0\"; }\n};\n\nstatic vector<string> g_lines;\nstatic string line(size_t i) { return i < g_lines.size() ? g_lines[i] : string(); }\n\nstatic vector<int> readAllInt(Tok tk) {\n    vector<int> res;\n    while (tk.i < tk.t.size()) res.push_back(stoi(tk.next()));\n    return res;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    for (string l; getline(cin, l);) {\n        if (!l.empty() && l.back() == '\\r') l.pop_back();\n        g_lines.push_back(l);\n    }\n    vector<int> nums = readAllInt(Tok(line(0)));\n    int result = solve(nums);\n    cout << result << \"\\n\";\n    return 0;\n}\n",
    "csharp": "using System;\nusing System.Collections.Generic;\nusing System.Linq;\n\npublic class Program {\n    static int Solve(int[] nums) {\n        // Return the max sum of non-adjacent elements.\n        return 0;\n    }\n\n    class Tok {\n        readonly string[] t;\n        int i;\n        public Tok(string s) { t = s.Split(new[] { ' ', '\\t' }, StringSplitOptions.RemoveEmptyEntries); }\n        public string Next() => i < t.Length ? t[i++] : \"0\";\n        public int Left => t.Length - i;\n    }\n\n    static string[] lines = new string[0];\n    static string Line(int i) => i < lines.Length ? lines[i] : \"\";\n\n    static int[] ReadAllInt(Tok tk) {\n        var res = new int[tk.Left];\n        for (int i = 0; i < res.Length; i++) res[i] = int.Parse(tk.Next());\n        return res;\n    }\n\n    public static void Main() {\n        lines = Console.In.ReadToEnd().Split('\\n').Select(_l => _l.TrimEnd('\\r')).ToArray();\n        int[] nums = ReadAllInt(new Tok(Line(0)));\n        var result = Solve(nums);\n        Console.WriteLine(result);\n    }\n}\n",
    "go": "package main\n\nimport (\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n)\n\nfunc solve(nums []int) int {\n\t// Return the max sum of non-adjacent elements.\n\treturn 0\n}\n\nfunc atoi(s string) int {\n\tv, _ := strconv.Atoi(strings.TrimSpace(s))\n\treturn v\n}\n\nfunc readAllInt(s string) []int {\n\tf := strings.Fields(s)\n\tres := make([]int, len(f))\n\tfor i, w := range f {\n\t\tres[i] = atoi(w)\n\t}\n\treturn res\n}\n\nfunc main() {\n\tdata, _ := io.ReadAll(os.Stdin)\n\tlines := strings.Split(strings.ReplaceAll(string(data), \"\\r\", \"\"), \"\\n\")\n\tline := func(i int) string {\n\t\tif i < len(lines) {\n\t\t\treturn lines[i]\n\t\t}\n\t\treturn \"\"\n\t}\n\tnums := readAllInt(line(0))\n\tresult := solve(nums)\n\tfmt.Println(result)\n}\n",
    "rust": "#![allow(unused_imports, unused_variables, unused_mut, dead_code)]\nuse std::collections::{HashMap, HashSet, VecDeque};\nuse std::io::{self, Read};\n\nfn solve(nums: Vec<i32>) -> i32 {\n    // Return the max sum of non-adjacent elements.\n    0\n}\n\nfn line<'a>(lines: &[&'a str], i: usize) -> &'a str {\n    lines.get(i).copied().unwrap_or(\"\")\n}\n\nfn main() {\n    let mut input = String::new();\n    io::stdin().read_to_string(&mut input).unwrap();\n    let lines: Vec<&str> = input.split('\\n').map(|l| l.trim_end_matches('\\r')).collect();\n    let nums: Vec<i32> = line(&lines, 0).split_whitespace().map(|x| x.parse::<i32>().unwrap()).collect();\n    let result = solve(nums);\n    println!(\"{}\", result);\n}\n",
    "kotlin": "fun solve(nums: IntArray): Int {\n    // Return the max sum of non-adjacent elements.\n    return 0\n}\n\nclass Tok(s: String) {\n    private val t = s.trim().split(Regex(\"\\\\s+\")).filter { it.isNotEmpty() }\n    private var i = 0\n    fun next(): String = if (i < t.size) t[i++] else \"0\"\n    fun left(): Int = t.size - i\n}\n\nfun readAllInt(tk: Tok): IntArray = IntArray(tk.left()) { tk.next().toInt() }\n\nfun main() {\n    val lines = generateSequence(::readLine).map { it.trimEnd('\\r') }.toList()\n    fun line(i: Int): String = lines.getOrElse(i) { \"\" }\n    val nums = readAllInt(Tok(line(0)))\n    val result = solve(nums)\n    println(result)\n}\n",
    "swift": "import Foundation\n\nfunc solve(_ nums: [Int]) -> Int {\n    // Return the max sum of non-adjacent elements.\n    return 0\n}\n\nfinal class Tok {\n    let t: [String]\n    var i = 0\n    init(_ s: String) { t = s.split(whereSeparator: { $0 == \" \" || $0 == \"\\t\" }).map(String.init) }\n    func next() -> String {\n        if i < t.count { i += 1; return t[i - 1] }\n        return \"0\"\n    }\n    var left: Int { t.count - i }\n}\n\nfunc readAllInt(_ tk: Tok) -> [Int] {\n    var res: [Int] = []\n    while tk.left > 0 { res.append(Int(tk.next())!) }\n    return res\n}\n\nvar lines: [String] = []\nwhile let l = readLine() { lines.append(l) }\nfunc line(_ i: Int) -> String { i < lines.count ? lines[i] : \"\" }\n\nlet nums: [Int] = readAllInt(Tok(line(0)))\nlet result = solve(nums)\nprint(result)\n",
    "ruby": "def solve(nums)\n  # Return the max sum of non-adjacent elements.\n  0\nend\n\ndef line(lines, i)\n  (lines[i] || \"\").chomp\nend\n\nlines = STDIN.read.split(\"\\n\", -1)\nnums = line(lines, 0).split.map { |x| x.to_i }\nresult = solve(nums)\nputs result.to_s\n",
    "php": "<?php\n\nfunction solve(array $nums): int {\n    // Return the max sum of non-adjacent elements.\n    return 0;\n}\n\nfunction line(array $lines, int $i): string {\n    return rtrim($lines[$i] ?? \"\", \"\\r\");\n}\n\nfunction readWords(string $s): array {\n    return preg_split('/\\s+/', trim($s), -1, PREG_SPLIT_NO_EMPTY);\n}\n\n$lines = explode(\"\\n\", stream_get_contents(STDIN));\n$nums = array_map(fn($x) => intval($x), readWords(line($lines, 0)));\n$result = solve($nums);\necho $result, \"\\n\";\n",
    "scala": "import scala.collection.mutable\n\nclass Tok(s: String) {\n  private val t = s.trim.split(\"\\\\s+\").filter(_.nonEmpty)\n  private var i = 0\n  def next(): String = if (i < t.length) { i += 1; t(i - 1) } else \"0\"\n  def left: Int = t.length - i\n}\n\nobject Main {\n  def solve(nums: Array[Int]): Int = {\n    // Return the max sum of non-adjacent elements.\n    0\n  }\n\n  def readAllInt(tk: Tok): Array[Int] = Array.fill(tk.left)(tk.next().toInt)\n\n  def main(args: Array[String]): Unit = {\n    val lines = scala.io.Source.stdin.getLines().toArray\n    def line(i: Int): String = if (i < lines.length) lines(i).stripSuffix(\"\\r\") else \"\"\n    val nums = readAllInt(new Tok(line(0)))\n    val result = solve(nums)\n    println(result)\n  }\n}\n",
    "dart": "import 'dart:io';\n\nint solve(List<int> nums) {\n  // Return the max sum of non-adjacent elements.\n  return 0;\n}\n\nclass Tok {\n  final List<String> t;\n  int i = 0;\n  Tok(String s) : t = s.trim().split(RegExp(r'\\s+')).where((w) => w.isNotEmpty).toList();\n  String next() => i < t.length ? t[i++] : '0';\n  int get left => t.length - i;\n}\n\nList<int> readAllInt(Tok tk) => List.generate(tk.left, (_) => int.parse(tk.next()));\n\nvoid main() {\n  final lines = <String>[];\n  while (true) {\n    final l = stdin.readLineSync();\n    if (l == null) break;\n    lines.add(l);\n  }\n  String line(int i) => i < lines.length ? lines[i] : '';\n  final List<int> nums = readAllInt(Tok(line(0)));\n  final result = solve(nums);\n  print(result);\n}\n",

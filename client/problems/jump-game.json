    "java": "import java.io.*;\nimport java.util.*;\n\npublic class Main {\n    static boolean solve(int[] nums) {\n        // Return true if you can reach the last index.\n        return false;\n    }\n\n    static String line(List<String> lines, int i) {\n        return i < lines.size() ? lines.get(i) : \"\";\n    }\n\n    static String[] readWords(String s) {\n        String t = s.trim();\n        return t.isEmpty() ? new String[0] : t.split(\"\\\\s+\");\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        List<String> lines = new ArrayList<>();\n        for (String l; (l = br.readLine()) != null; ) lines.add(l);\n        int[] nums = Arrays.stream(readWords(line(lines, 0))).mapToInt(Integer::parseInt).toArray();\n        boolean result = solve(nums);\n        System.out.println(result ? \"true\" : \"false\");\n    }\n}\n",
    "c": "#include <stdbool.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\nbool solve(int* nums, int numsSize) {\n    // Return true if you can reach the last index.\n    return false;\n}\n\nstatic char* read_all(void) {\n    size_t cap = 1 << 16, len = 0;\n    char* buf = malloc(cap);\n    for (;;) {\n        if (len + 1 >= cap) buf = realloc(buf, cap *= 2);\n        size_t r = fread(buf + len, 1, cap - len - 1, stdin);\n        if (r == 0) break;\n        len += r;\n    }\n    buf[len] = '\\0';\n    return buf;\n}\n\nstatic char** g_lines;\nstatic int g_count;\n\nstatic char* line(int i) {\n    return i < g_count ? g_lines[i] : \"\";\n}\n\nstatic int* parse_ints(const char* s, int* n) {\n    int cap = 16;\n    int* out = malloc(cap * sizeof(int));\n    char* end;\n    *n = 0;\n    for (;;) {\n        long v = strtol(s, &end, 10);\n        if (end == s) break;\n        if (*n == cap) out = realloc(out, (cap *= 2) * sizeof(int));\n        out[(*n)++] = (int)v;\n        s = end;\n    }\n    return out;\n}\n\nint main(void) {\n    char* input = read_all();\n    int cap = 8;\n    g_lines = malloc(cap * sizeof(char*));\n    for (char* p = input;;) {\n        if (g_count == cap) g_lines = realloc(g_lines, (cap *= 2) * sizeof(char*));\n        g_lines[g_count++] = p;\n        char* nl = strchr(p, '\\n');\n        size_t n = nl ? (size_t)(nl - p) : strlen(p);\n        if (n && p[n - 1] == '\\r') p[n - 1] = '\\0';\n        if (!nl) break;\n        *nl = '\\0';\n        p = nl + 1;\n    }\n    int numsSize = 0;\n    int* nums = parse_ints(line(0), &numsSize);\n    bool result = solve(nums, numsSize);\n    printf(\"%s\\n\", result ? \"true\" : \"false\");\n    return 0;\n}\n",
    "cpp": "#include <algorithm>\n#include <climits>\n#include <iostream>\n#include <map>\n#include <queue>\n#include <set>\n#include <sstream>\n#include <stack>\n#include <string>\n#include <unordered_map>\n#include <unordered_set>\n#include <vector>\nusing namespace std;\n\nbool solve(vector<int>& nums) {\n    // Return true if you can reach the last index.\n    return false;\n}\n\nstatic vector<string> g_lines;\nstatic string line(size_t i) { return i < g_lines.size() ? g_lines[i] : string(); }\nstatic vector<int> readInts(const string& s) {\n    vector<int> v;\n    istringstream is(s);\n    for (int x; is >> x;) v.push_back(x);\n    return v;\n}\nstatic vector<string> readWords(const string& s) {\n    vector<string> v;\n    istringstream is(s);\n    for (string w; is >> w;) v.push_back(w);\n    return v;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    for (string l; getline(cin, l);) {\n        if (!l.empty() && l.back() == '\\r') l.pop_back();\n        g_lines.push_back(l);\n    }\n    vector<int> nums = readInts(line(0));\n    bool result = solve(nums);\n    cout << (result ? \"true\" : \"false\") << \"\\n\";\n    return 0;\n}\n",
    "csharp": "using System;\nusing System.Collections.Generic;\nusing System.Linq;\n\npublic class Program {\n    static bool Solve(int[] nums) {\n        // Return true if you can reach the last index.\n        return false;\n    }\n\n    static string[] lines = new string[0];\n    static string Line(int i) => i < lines.Length ? lines[i] : \"\";\n    static string[] Words(string s) => s.Split(new[] { ' ', '\\t' }, StringSplitOptions.RemoveEmptyEntries);\n\n    public static void Main() {\n        lines = Console.In.ReadToEnd().Split('\\n').Select(l => l.TrimEnd('\\r')).ToArray();\n        int[] nums = Words(Line(0)).Select(int.Parse).ToArray();\n        var result = Solve(nums);\n        Console.WriteLine(result ? \"true\" : \"false\");\n    }\n}\n",
    "go": "package main\n\nimport (\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n)\n\nfunc solve(nums []int) bool {\n\t// Return true if you can reach the last index.\n\treturn false\n}\n\nfunc atoi(s string) int {\n\tv, _ := strconv.Atoi(s)\n\treturn v\n}\n\nfunc parseInts(s string) []int {\n\tf := strings.Fields(s)\n\tout := make([]int, len(f))\n\tfor i, w := range f {\n\t\tout[i] = atoi(w)\n\t}\n\treturn out\n}\n\nfunc main() {\n\tdata, _ := io.ReadAll(os.Stdin)\n\tlines := strings.Split(strings.ReplaceAll(string(data), \"\\r\", \"\"), \"\\n\")\n\tline := func(i int) string {\n\t\tif i < len(lines) {\n\t\t\treturn lines[i]\n\t\t}\n\t\treturn \"\"\n\t}\n\tnums := parseInts(line(0))\n\tresult := solve(nums)\n\tfmt.Println(result)\n}\n",
